{
  "name": "vika-fusion-mcp",
  "version": "1.0.1",
  "description": "MCP server and TypeScript library for the public Vika Fusion API.",
  "type": "module",
  "bin": {
    "vika-fusion-mcp": "bin/vika-fusion-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lorwell/vika-mcp.git"
  },
  "homepage": "https://github.com/Lorwell/vika-mcp#readme",
  "bugs": {
    "url": "https://github.com/Lorwell/vika-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "test": "vitest run",
    "test:live:all": "tsx tests/live/all-tools.ts",
    "test:smoke": "tsx tests/smoke/smoke.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "vika",
    "datasheet",
    "vika-fusion",
    "model-context-protocol"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "qs": "^6.16.0",
    "undici": "^7.29.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/qs": "^6.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
